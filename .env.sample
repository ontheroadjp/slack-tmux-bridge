SLACK_BOT_TOKEN=your-slack-bot-token
SLACK_APP_TOKEN=your-slack-app-token
TARGET_CHANNEL_ID=your-slack-channel-id
LOG_LEVEL=INFO
# Output diff: replace | suffix
# Event healthcheck: seconds without events before warning (set 0 to disable)
EVENT_HEALTH_TIMEOUT=600
# Action when healthcheck triggers: log | exit | restart
EVENT_HEALTH_ACTION=log
# Cooldown for restart (seconds)
EVENT_HEALTH_RESTART_COOLDOWN_SEC=300
# Notify inactive channels (1=on)
EVENT_HEALTH_NOTIFY=0
# Cooldown for health notifications (seconds)
EVENT_HEALTH_NOTIFY_COOLDOWN_SEC=600
# Cache cleanup
PROMPT_CACHE_TTL_SEC=3600
# Permission prompt watch
PERMISSION_WATCH_SEC=120
PERMISSION_WATCH_INTERVAL_SEC=2
PERMISSION_WATCH_PATTERN=(Allow once|Allow always|Approve|Permission|許可|承認)
# /now watch
NOW_WATCH_INTERVAL_SEC=1
NOW_WATCH_IDLE_COUNT=3
NOW_WATCH_TIMEOUT_SEC=180
# Command filtering (comma-separated patterns; use "all" to match everything)
# COMMAND_ALLOWLIST=all
# COMMAND_DENYLIST=sudo,rm -rf,/\\brm\\b/,mkfs,dd,/\\bshutdown\\b/,/\\breboot\\b/,/curl\\s+.*\\|\\s*sh/,/wget\\s+.*\\|\\s*sh/
